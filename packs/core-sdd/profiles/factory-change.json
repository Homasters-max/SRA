{
  "$schema": "warrant://profile/1",
  "id": "factory-change",
  "version": "1.1.0",
  "description": "Change to the WARRANT factory itself: packs, schemas, skills, project configuration, CI workflows and the CLI that judges them.",
  "extends": [
    "feature"
  ],
  "match": {
    "paths": [
      ".warrant/**",
      "openspec/schemas/**",
      "openspec/config.yaml",
      "packs/**",
      "packages/cli/schemas/**",
      "sra/skills/**",
      ".github/workflows/**",
      "packages/cli/src/**",
      "packages/cli/package.json"
    ]
  },
  "gates": {
    "VERIFYING->MERGED": [
      "factory-golden-passed"
    ]
  },
  "capabilities": {
    "forbidden": [
      "PRODUCTION_WRITE"
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/dev/cs-hook.js\" post-tool",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Read|Grep|Glob|Bash|PowerShell"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/dev/cs-hook.js\" subagent-start",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ]
  }
}

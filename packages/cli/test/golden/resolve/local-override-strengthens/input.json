{
  "packs": [
    "policy"
  ],
  "local": {
    "overlays/baseline.json": {
      "$schema": "warrant://overlay/1",
      "id": "baseline",
      "version": "1.1.0",
      "overrides": "policy:baseline",
      "description": "Project override: keeps everything and adds tasks and lint-passed.",
      "artifacts": {
        "required": [
          "proposal",
          "specs",
          "tasks"
        ]
      },
      "gates": {
        "VERIFYING->MERGED": [
          "tests-passed",
          "lint-passed"
        ]
      }
    }
  }
}

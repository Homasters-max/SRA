{
  "$schema": "warrant://pack/1",
  "id": "data",
  "version": "0.3.0",
  "kernel": ">=0.1 <0.2",
  "depends_on": {
    "core-sdd": ">=0.1"
  },
  "provides": {
    "profiles": [
      "profiles/data-change.json",
      "profiles/migration.json"
    ],
    "gates": [
      "gates/contract-compatible.json",
      "gates/reconciliation-passed.json"
    ],
    "checks": [
      "checks/contract-diff.json"
    ],
    "risk_floors": [
      "risk/floors.json"
    ],

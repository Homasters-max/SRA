{
  "$schema": "warrant://openspec-schema/1",
  "name": "warrant-sdd",
  "version": 1,
  "description": "Spec-driven workflow with WARRANT governance rules.",
  "artifacts": [
    {
      "id": "proposal",
      "generates": "proposal.md",
      "description": "Why the Change exists and what is out of scope.",
      "template": "proposal.md",
      "requires": []
    },
    {
      "id": "specs",
      "generates": "specs/spec.md",
      "description": "Observable behaviour as requirements and scenarios.",
      "template": "spec.md",
      "requires": [
        "adr"
      ]
    },
    {
      "id": "design",
      "generates": "design.md",
      "description": "Decisions and alternatives behind the implementation.",
      "template": "design.md",
      "requires": [
        "proposal"
      ]
    },
    {
      "id": "tasks",
      "generates": "tasks.md",
      "description": "Independently verifiable implementation tasks.",
      "template": "tasks.md",
      "requires": [
        "specs",
        "design"
      ]
    }
  ],
  "apply": {
    "requires": [
      "tasks"
    ],
    "tracks": "tasks.md",
    "instruction": "Run warrant status before marking a task done."
  }
}

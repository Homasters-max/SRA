{
  "$schema": "warrant://pack/1",
  "id": "core-sdd",
  "version": "0.2.1",
  "kernel": ">=0.1 <0.4",
  "description": "Baseline spec-driven workflow for OpenSpec with the WARRANT governance rules.",
  "depends_on": {},
  "provides": {
    "profiles": [
      "profiles/chore.json",
      "profiles/factory-change.json",
      "profiles/feature.json"
    ],
    "overlays": [
      "overlays/core-default.json",
      "overlays/risk-high.json",
      "overlays/risk-low.json",
      "overlays/risk-medium.json"
    ],
    "gates": [
      "gates/adversarial-review.json",
      "gates/analyze-clean.json",
      "gates/blocking-unknowns-resolved.json",
      "gates/branch-isolated.json",
      "gates/evidence-complete.json",
      "gates/factory-golden-passed.json",
      "gates/human-approval.json",
      "gates/ids-valid.json",
      "gates/required-artifacts-present.json",
      "gates/scope-valid.json",
      "gates/spec-valid.json",
      "gates/tests-passed.json"
    ],
    "checks": [
      "checks/openspec-validate.json",
      "checks/tests-passed.json"
    ],
    "risk_floors": [
      "risk/floors.json"
    ],
    "risk_levels": [
      "risk/levels.json"
    ],
    "controller_rules": [
      "controller/rules.json"
    ],
    "recipes": [],
    "rules": [],
    "templates": [
      "openspec/templates/proposal.md",
      "openspec/templates/spec.md",
      "openspec/templates/design.md",
      "openspec/templates/tasks.md"
    ],
    "openspec_schema": "openspec/schema.json",
    "openspec_rules": "openspec/rules.json",
    "skills": [
      "specification/adversarial-review@^0.1"
    ],
    "evidence_kinds": [
      {
        "kind": "test-report",
        "metrics_schema": "evidence/test-report.metrics.schema.json"
      },
      {
        "kind": "spec-report",
        "metrics_schema": "evidence/spec-report.metrics.schema.json"
      },
      "review",
      "human-approval"
    ]
  }
}
